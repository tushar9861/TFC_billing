rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // SaaS Master Registration Directory
    // Any new desktop client can register their shop details here.
    match /registered_shops/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null; // For simplicity in beta
    }

    // Isolated Tenant Data (SaaS)
    // Any authenticated shop owner can read/write to their own shop's data.
    match /shops/{shopId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // License Keys Validation Directory
    match /license_keys/{document=**} {
      allow read: if true; // Publicly readable to validate licenses before signup
      allow update: if request.auth != null; // Allow authenticated users to mark key as used
      allow create, delete: if false; // Only manageable from Firebase Console by developer
    }
  }
}
